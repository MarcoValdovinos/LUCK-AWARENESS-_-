{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence",
  "description": "Esquema de validación para la evidencia forense guardada",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]{8}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "originalText": {
      "type": "string"
    },
    "urls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "emails": {
      "type": "array",
      "items": { "type": "string" }
    },
    "flags": {
      "type": "array",
      "items": { "type": "object" }
    },
    "risk": {
      "type": "object",
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "level": { "type": "string", "enum": ["Bajo", "Medio", "Alto", "Crítico"] },
        "cssClass": { "type": "string" }
      },
      "required": ["score", "level", "cssClass"]
    }
  },
  "required": ["id", "timestamp", "hash", "originalText", "urls", "emails", "flags", "risk"]
}
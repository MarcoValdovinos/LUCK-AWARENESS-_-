{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Message",
  "description": "Esquema de validación para el mensaje analizado",
  "type": "object",
  "properties": {
    "original": {
      "type": "string",
      "description": "El texto exacto ingresado por el usuario"
    },
    "text": {
      "type": "string",
      "description": "El texto limpio y normalizado para análisis"
    },
    "urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "emails": {
      "type": "array",
      "items": { "type": "string", "format": "email" }
    },
    "length": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["original", "text", "urls", "emails", "length"]
}